NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/mrs_medical_services
DATABASE_PUBLIC_URL=
# Required in production: set to your public site URL. The server refuses to
# start in production without it, since it is used to build Stripe checkout
# URLs and emailed confirm/deny/approval links, which must never fall back to
# request headers.
SITE_ORIGIN=https://www.mrsmedicalservices.com
CLIENT_ORIGIN=http://localhost:5173
# Optional in production: PEM-encoded CA certificate for the Postgres server,
# used to verify its TLS certificate. If DATABASE_URL points at a Railway
# private network host (*.railway.internal) this is not required.
DATABASE_CA_CERT=
RESEND_API_KEY=re_your_resend_api_key
CONTACT_TO_EMAIL=dirving.mrsms@gmail.com
CONTACT_FROM_EMAIL=M.R.S. Medical Services <contact@mrsmedicalservices.com>
ADMIN_PASSWORD=change-this-before-deploy
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_SUCCESS_URL=http://localhost:5173/dashboard?payment=success
STRIPE_CANCEL_URL=http://localhost:5173/dashboard?payment=cancelled
STRIPE_CURRENCY=usd
